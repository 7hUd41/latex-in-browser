[Unit]
Description=LaTeX editor (latex-in-browser)
After=network.target

[Service]
Type=simple
User=latex
Group=latex
WorkingDirectory=/opt/latex-editor
ExecStart=/usr/bin/node /opt/latex-editor/server/server.js
Environment=PORT=8090
Environment=DOCS_DIR=/var/lib/latex/docs
# Author of the commits made from the editor: put your own name and email.
Environment=GIT_NAME=latex-in-browser
Environment=GIT_EMAIL=latex@localhost
# AUTH_USER, AUTH_HASH, SESSION_SECRET (made by server/hash-password.js)
EnvironmentFile=/etc/latex-editor.env
Restart=on-failure
RestartSec=2

# Hardening. Every compilation inherits these limits.
# AF_NETLINK: bubblewrap needs it to set up the (empty) network of the sandbox.
# No RestrictSUIDSGID: it blocks openat2(), which bubblewrap needs.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/latex
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=1500M
TasksMax=128
UMask=0027

[Install]
WantedBy=multi-user.target
